[Unit]
Description=Build and deploy waonme/world-app main on the local VPS
Wants=network-online.target
After=network-online.target snap.microk8s.daemon-kubelite.service

[Service]
Type=oneshot
User=orange
Group=orange
SupplementaryGroups=microk8s
Environment=WORLD_APP_DEPLOY_BASE=/home/orange/world-app-deployer
ExecStart=/home/orange/world-app-deployer/bin/deploy.sh
TimeoutStartSec=60min
TimeoutStopSec=6min
KillMode=control-group
Nice=10
IOSchedulingClass=best-effort
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/orange/world-app-deployer
